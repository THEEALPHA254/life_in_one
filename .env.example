# === Supabase (frontend) ===
# Get these from your Supabase project settings → API
# For local dev with `supabase start`, values are printed to the terminal.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === Google Calendar (frontend OAuth start) ===
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI (dev): http://localhost:5173/auth/google/callback
VITE_GOOGLE_CLIENT_ID=

# === Bible API ===
# Option A (recommended): https://scripture.api.bible → free key, no rate limits for personal use
# Option B: leave blank to fall back to bible-api.com (no key required)
VITE_BIBLE_API_KEY=
VITE_BIBLE_API_BASE=https://api.scripture.api.bible/v1

# === Edge functions (server-side; set via `supabase secrets set`) ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_HEALTH_CLIENT_ID=      # v2 — health provider integration
# GOOGLE_HEALTH_CLIENT_SECRET=
