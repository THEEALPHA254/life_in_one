{
  "name": "life-in-one",
  "version": "0.0.1",
  "private": true,
  "description": "Personal Life OS — multipurpose life management web app",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lio/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/core/src/types/supabase.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
