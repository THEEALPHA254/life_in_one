# Hoist all transitive deps to node_modules root (npm/yarn-style flat layout).
# Required for Metro / React Native / Expo: their resolvers walk classic
# node_modules paths and choke on pnpm's virtual .pnpm/ store when following
# transitive requires like `require('invariant')` inside react-native/index.js.
# Web app is unaffected (Vite handles isolated layout natively).
shamefully-hoist=true
